#version 450

#extension GL_EXT_control_flow_attributes : require

#include "types.glsl"

// Mamba-1's selective scan, whose decay A has a value for each state element: one invocation carries the D_STATE states
// of one row (a head's position of head_dim) of one sequence through every token, in registers, and sums its output in
// the order the CPU does.

layout(constant_id = 0) const uint BLOCK_SIZE = 128;
layout(constant_id = 1) const uint D_STATE = 16;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer Src0 { float s0[]; };
layout(binding = 1) readonly buffer Src1 { float x[]; };
layout(binding = 2) readonly buffer Src2 { float dt[]; };
layout(binding = 3) readonly buffer Src3 { float A[]; };
layout(binding = 4) readonly buffer Src4 { float B[]; };
layout(binding = 5) readonly buffer Src5 { float C[]; };
layout(binding = 6) readonly buffer Src6 { int ids[]; };
layout(binding = 7) buffer Dst { float d[]; };

layout(push_constant) uniform PushConstants {
    uint nb02; uint nb03; uint nb12; uint nb13;
    uint nb21; uint nb22; uint nb31;
    uint nb42; uint nb43; uint nb52; uint nb53;
    uint s_off;
    uint n_head;
    uint d_head;
    uint n_group;
    uint n_tok;
    uint n_seq;
    uint K;
};

float softplus(float x) {
    if (x <= 20.0) {
        return log(1.0 + exp(x));
    } else {
        return x;
    }
}

void main() {
    const uint row     = gl_GlobalInvocationID.x;
    const uint seq_idx = gl_WorkGroupID.y;

    if (row >= n_head * d_head) {
        return;
    }

    const uint head_idx = row / d_head;
    const uint head_off = (row % d_head) * D_STATE;

    const uint group_off   = (head_idx / (n_head / n_group)) * D_STATE;
    const uint s0_base_idx = (uint(ids[seq_idx]) * nb03 + head_idx * nb02) / 4 + head_off;
    const uint x_base_idx  = (seq_idx * nb13) / 4 + row;
    const uint dt_base_idx = (seq_idx * nb22) / 4 + head_idx;
    const uint A_base_idx  = (head_idx * nb31) / 4;
    const uint B_base_idx  = (seq_idx * nb43) / 4 + group_off;
    const uint C_base_idx  = (seq_idx * nb53) / 4 + group_off;
    const uint y_base_idx  = seq_idx * n_tok * n_head * d_head + row;
    const uint s_base_idx  = (s_off + seq_idx * nb03 + head_idx * nb02) / 4 + head_off;

    const uint stride_x  = nb12 / 4;
    const uint stride_dt = nb21 / 4;
    const uint stride_B  = nb42 / 4;
    const uint stride_C  = nb52 / 4;
    const uint stride_y  = n_head * d_head;

    float state[D_STATE];
    float a[D_STATE];

    [[unroll]] for (uint j = 0; j < D_STATE; j++) {
        state[j] = s0[s0_base_idx + j];
        a[j]     = A[A_base_idx + j];
    }

    for (uint i = 0; i < n_tok; i++) {
        const float dt_soft_plus = softplus(dt[dt_base_idx + i * stride_dt]);
        const float x_dt         = x[x_base_idx + i * stride_x] * dt_soft_plus;

        float sum = 0.0f;
        [[unroll]] for (uint j = 0; j < D_STATE; j++) {
            state[j] = (state[j] * exp(dt_soft_plus * a[j])) + (B[B_base_idx + i * stride_B + j] * x_dt);
            sum += state[j] * C[C_base_idx + i * stride_C + j];
        }

        d[y_base_idx + i * stride_y] = sum;
    }

    [[unroll]] for (uint j = 0; j < D_STATE; j++) {
        d[s_base_idx + j] = state[j];
    }
}
